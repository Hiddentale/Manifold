#version 450

layout(local_size_x = 64) in;

struct MeshChunkInfo {
    vec3 aabb_min;
    uint voxel_slot;
    vec3 aabb_max;
    uint boundary_slot;
    ivec3 chunk_pos;
    uint face_id;
};

layout(std430, set = 0, binding = 0) readonly buffer ChunkInfoBuffer {
    MeshChunkInfo chunks[];
};

layout(std430, set = 0, binding = 1) readonly buffer VoxelDataBuffer {
    uint voxel_data[];
};

layout(std430, set = 0, binding = 2) readonly buffer BoundaryDataBuffer {
    uint boundary_data[];
};

layout(std430, set = 0, binding = 3) readonly buffer VisiblePhase1 {
    uint visible_phase1[];
};

layout(std430, set = 0, binding = 4) readonly buffer VisiblePhase2 {
    uint visible_phase2[];
};

layout(std430, set = 0, binding = 5) buffer FacesOut {
    uvec2 faces[];
};

layout(std430, set = 0, binding = 6) buffer DrawArgs {
    uint vertex_count;
    uint instance_count;
    uint first_vertex;
    uint first_instance;
};

layout(push_constant) uniform PushConstants {
    vec4 planes[6];
    vec3 camera_pos;
    uint chunk_count;
    vec2 screen_size;
    uint phase;
    uint opaque_mask;
    uint stereo;
};

const uint MAX_FACES = 4194304u;

bool sub_chunk_occupied(uint voxel_slot, uint sub_idx) {
    uint sx = (sub_idx & 3u) * 4u;
    uint sy = ((sub_idx >> 2u) & 3u) * 4u;
    uint sz = ((sub_idx >> 4u) & 3u) * 4u;

    for (uint dy = 0u; dy < 4u; dy++) {
        for (uint dz = 0u; dz < 4u; dz++) {
            uint idx = sx + (sz + dz) * 16u + (sy + dy) * 256u;
            uint word_idx = voxel_slot * 1024u + idx / 4u;
            uint packed = voxel_data[word_idx];
            if (packed != 0u) return true;
        }
    }
    return false;
}

const vec3 FACE_NORMALS[6] = vec3[6](
    vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0),
    vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1)
);

uint read_block(uint voxel_slot, uint x, uint y, uint z) {
    uint idx = x + z * 16u + y * 256u;
    uint word = voxel_data[voxel_slot * 1024u + idx / 4u];
    return (word >> ((idx % 4u) * 8u)) & 0xFFu;
}

uint read_boundary(uint boundary_slot, uint face, uint u, uint v) {
    uint idx = face * 256u + u + v * 16u;
    uint word = boundary_data[boundary_slot * 384u + idx / 4u];
    return (word >> ((idx % 4u) * 8u)) & 0xFFu;
}

bool is_opaque_block(uint block_type) {
    return (opaque_mask & (1u << block_type)) != 0u;
}

bool should_emit(uint block, uint neighbor) {
    if (is_opaque_block(block)) return !is_opaque_block(neighbor);
    if (block == 4u) return neighbor == 0u;
    return false;
}

uint get_neighbor(uint voxel_slot, uint boundary_slot, int x, int y, int z, uint face) {
    if (x >= 0 && x < 16 && y >= 0 && y < 16 && z >= 0 && z < 16) {
        return read_block(voxel_slot, uint(x), uint(y), uint(z));
    }
    uint bu, bv;
    if (face == 0u) { bu = uint(z); bv = uint(y); }
    else if (face == 1u) { bu = uint(z); bv = uint(y); }
    else if (face == 2u) { bu = uint(x); bv = uint(z); }
    else if (face == 3u) { bu = uint(x); bv = uint(z); }
    else if (face == 4u) { bu = uint(x); bv = uint(y); }
    else { bu = uint(x); bv = uint(y); }
    return read_boundary(boundary_slot, face, bu, bv);
}

uint compute_face_mask(uint voxel_slot, uint boundary_slot, uint block, uint gx, uint gy, uint gz) {
    if (block == 0u) return 0u;
    uint mask = 0u;
    for (uint face = 0u; face < 6u; face++) {
        ivec3 ndir = ivec3(FACE_NORMALS[face]);
        int nx = int(gx) + ndir.x;
        int ny = int(gy) + ndir.y;
        int nz = int(gz) + ndir.z;
        uint neighbor = get_neighbor(voxel_slot, boundary_slot, nx, ny, nz, face);
        if (should_emit(block, neighbor)) {
            mask |= (1u << face);
        }
    }
    return mask;
}

void main() {
    uint slot = gl_WorkGroupID.x;
    uint chunk_idx = (phase == 1u) ? visible_phase1[slot] : visible_phase2[slot];
    MeshChunkInfo chunk = chunks[chunk_idx];

    uint tid = gl_LocalInvocationID.x;
    uint sx = (tid & 3u) * 4u;
    uint sy = ((tid >> 2u) & 3u) * 4u;
    uint sz = ((tid >> 4u) & 3u) * 4u;
    if (!sub_chunk_occupied(chunk.voxel_slot, tid)) return;

    for (uint v = 0u; v < 64u; v++) {
        uint lx = v & 3u;
        uint ly = (v >> 2u) & 3u;
        uint lz = (v >> 4u) & 3u;
        uint gx = sx + lx;
        uint gy = sy + ly;
        uint gz = sz + lz;

        uint block = read_block(chunk.voxel_slot, gx, gy, gz);
        uint face_mask = compute_face_mask(chunk.voxel_slot, chunk.boundary_slot, block, gx, gy, gz);
        if (face_mask == 0u) continue;

        for (uint face = 0u; face < 6u; face++) {
            if ((face_mask & (1u << face)) == 0u) continue;

            uint base = atomicAdd(vertex_count, 6u);
            uint face_slot = base / 6u;
            if (face_slot >= MAX_FACES) continue;

            uint packed = gx | (gy << 5) | (gz << 10) | (face << 15) | (block << 18);
            faces[face_slot] = uvec2(chunk_idx, packed);
        }
    }
}
